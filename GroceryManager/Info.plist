<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MealyAPIBaseURL</key>
	<string>$(MEALY_API_BASE_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a screenshot, cookbook photo or handwritten card to import a recipe. Text is read on your device.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>AddStorageLocationIntent</string>
		<string>RemoveStorageLocationIntent</string>
		<string>AddIngredientIntent</string>
		<string>RemoveIngredientIntent</string>
		<string>AddRecipeIntent</string>
		<string>RemoveRecipeIntent</string>
		<string>work.pumpkinpatch.mealy.viewRecipe</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
