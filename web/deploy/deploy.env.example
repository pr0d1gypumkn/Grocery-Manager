# Copy to deploy.env (git-ignored) and fill in.
EC2_HOST=
EC2_USER=ubuntu            # ec2-user on Amazon Linux
SSH_KEY=~/.ssh/mealy.pem
DOMAIN=api.example.com     # used by --setup for nginx/TLS
CERTBOT_EMAIL=             # set to get a Let's Encrypt cert during --setup

# RDS (used by --setup / --setup-db). The master password is prompted, never stored here.
RDS_HOST=                  # e.g. mealy-db.abc123xyz.us-east-1.rds.amazonaws.com
RDS_MASTER_USER=postgres   # the master username you chose when creating the RDS instance
DB_NAME=mealy              # app database to create
DB_USER=mealy              # app role to create (gets a random password)
