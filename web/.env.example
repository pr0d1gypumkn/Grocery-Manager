# Postgres (docker compose up -d gives you this one)
DATABASE_URL="postgresql://mealy:mealy@localhost:5433/mealy?schema=public"

# Sign-in tokens
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Email provider for sign-in codes (optional in dev: the code is printed to the server log and echoed in the API response)
RESEND_API_KEY=""
MAIL_FROM="Mealy <no-reply@example.com>"

# Stripe (web subscriptions)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# App Store Server Notifications V2: point Apple at /api/webhooks/appstore. Set to 1 only in development to skip chain checks.
APPLE_ALLOW_UNVERIFIED=
# iOS sign-in with Apple ID (no separate account). Bundle ID must match the app.
APPLE_BUNDLE_ID=work.pumpkinpatch.mealy
# Accept TestFlight/Xcode (sandbox) purchases for silent sign-in. Set to 1 on staging and during TestFlight.
APPLE_ALLOW_SANDBOX=
# Sign in with Apple key (Certificates, IDs & Profiles ▸ Keys). Needed to revoke Apple tokens
# on account deletion, which App Review requires. Paste the .p8 contents with \n for newlines.
APPLE_TEAM_ID=UF77TH29VG
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=

# Price / checkout partners. Leave empty to use the mock price source.
FLIPP_API_KEY=""
INSTACART_API_KEY=""
WALMART_API_KEY=""
KROGER_CLIENT_ID=""
PCEXPRESS_API_KEY=""

# Social import partners (optional)
META_OEMBED_TOKEN=""
YOUTUBE_API_KEY=""
