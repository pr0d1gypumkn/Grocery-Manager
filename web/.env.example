# Mealy backend environment.
# Local dev:  copy to .env             (docker compose up -d gives you the database below)
# Production: copy to .env.production  (deploy/deploy.sh uploads it to /opt/mealy/shared/.env)
# Never commit a filled-in copy. Values marked [required in prod] must be set on the server.

# ─── Database ───────────────────────────────────────────────────────────────
# Postgres connection string Prisma uses.
# Dev: the docker compose database below. Prod: LEAVE THIS OUT of .env.production;
# deploy.sh --setup-db writes the RDS URL to /opt/mealy/shared/database.env, which takes precedence.
DATABASE_URL="postgresql://mealy:mealy@localhost:5433/mealy?schema=public"

# ─── App / auth ─────────────────────────────────────────────────────────────
# [required in prod] Secret that signs sign-in tokens. Long random string; changing it logs everyone out.
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
# [required in prod] Public base URL of this server, no trailing slash. Used for Stripe checkout/portal
# return links. Dev: http://localhost:3000. Prod: https://api.yourdomain.com (same as DOMAIN in deploy.env).
APP_URL="http://localhost:3000"

# ─── Email (sign-in codes) ──────────────────────────────────────────────────
# Resend API key (resend.com > API Keys). Empty in dev: codes are printed to the server log instead.
# [required in prod] if anyone signs in by email; without it no codes are sent.
RESEND_API_KEY=""
# Sender for sign-in emails. The domain must be verified in Resend.
MAIL_FROM="Mealy <no-reply@example.com>"

# ─── Stripe (web subscriptions) ─────────────────────────────────────────────
# Secret key (Stripe Dashboard > Developers > API keys). sk_test_... in dev, sk_live_... in prod.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint pointed at {APP_URL}/api/webhooks/stripe (whsec_...).
# Dev: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=""
# Price IDs (price_...) of the Mealy Plus monthly and yearly prices (Product catalog > your product).
# Checkout is disabled until both are set.
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# ─── Apple (iOS sign-in, App Store purchases) ───────────────────────────────
# iOS app bundle ID; must match the app in Xcode / App Store Connect.
APPLE_BUNDLE_ID=work.pumpkinpatch.mealy
# Your Apple Developer Team ID (developer.apple.com > Membership details).
APPLE_TEAM_ID=UF77TH29VG
# Sign in with Apple key (Certificates, IDs & Profiles > Keys, with "Sign in with Apple" enabled).
# Needed to revoke Apple tokens when a user deletes their account, which App Review requires.
# KEY_ID is the 10-character key ID; PRIVATE_KEY is the .p8 file's contents on one line, with \n for newlines:
#   "-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
# Sandbox (TestFlight / Xcode / App Review) purchases are accepted for silent sign-in by default.
# Keep it that way in production: App Review buys in the sandbox and gets rejected otherwise.
# 0 = refuse sandbox purchases.
APPLE_ALLOW_SANDBOX=
# 1 = skip signature-chain checks on App Store Server Notifications (point App Store Connect at
# {APP_URL}/api/webhooks/appstore). Dev only: ignored when NODE_ENV=production.
APPLE_ALLOW_UNVERIFIED=

# ─── Grocery price / checkout partners (optional) ───────────────────────────
# Each source reports "not configured" until its key is set; the mock price source is used meanwhile.
FLIPP_API_KEY=""        # Flipp flyer data (CA/US weekly flyers)
INSTACART_API_KEY=""    # Instacart Developer Platform key (prices + checkout links)
WALMART_API_KEY=""      # Walmart affiliate / product API key
KROGER_CLIENT_ID=""     # Kroger developer app client ID (US stores)
PCEXPRESS_API_KEY=""    # PC Express (Loblaw) key (CA stores)

# ─── Social recipe import (optional) ────────────────────────────────────────
# Meta app token for Instagram oEmbed (developers.facebook.com > your app). Without it, Instagram
# imports fall back to pasted captions / screenshots.
META_OEMBED_TOKEN=""
# YouTube Data API key (Google Cloud console). Reserved: not read by the code yet.
YOUTUBE_API_KEY=""
